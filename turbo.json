{
  "$schema": "https://turborepo.org/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "bin/**"],
      "cache": false
    },
    "build:dev": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "bin/**"],
      "cache": false
    },
    "build:prod": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "bin/**"],
      "cache": false
    },
    "lint": {
      "outputs": [],
      "cache": false
    },
    "dev": {
      "outputs": [],
      "persistent": true,
      "cache": false
    },
    "package": {
      "dependsOn": ["build"],
      "outputs": ["release/**"],
      "cache": false
    },
    "package:dev": {
      "dependsOn": ["build:dev"],
      "outputs": ["release/**"],
      "cache": false
    },
    "package:prod": {
      "dependsOn": ["build:prod"],
      "outputs": ["release/**"],
      "cache": false
    },
    "package:mac": {
      "dependsOn": ["build"],
      "outputs": ["release/**"],
      "cache": false
    },
    "package:mac:dev": {
      "dependsOn": ["build:dev"],
      "outputs": ["release/**"],
      "cache": false
    },
    "package:mac:prod": {
      "dependsOn": ["build:prod"],
      "outputs": ["release/**"],
      "cache": false
    },
    "sonar": {
      "outputs": [],
      "cache": false
    },
    "worker": {
      "dependsOn": [],
      "outputs": []
    }
  }
}
