    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/qs": "^6.14.0",
    "@types/randomstring": "^1.3.0",
    "@types/ssh2": "^1.15.5",
    "@types/word-extractor": "^1.0.6",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
