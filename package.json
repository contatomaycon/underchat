    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.8.1",
    "tsx": "^4.22.4",
    "turbo": "^2.10.0",
    "typescript": "^6.0.3",
    "undici": "^8.5.0",
    "undici-types": "^8.5.0"
  },
