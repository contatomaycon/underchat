{
  "name": "underchat",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Underchat",
  "engines": {
    "node": "24.12.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "preinstall": "node -e \"if (process.env.EAS_BUILD === 'true') process.exit(0); if (process.version !== 'v24.12.0') { console.error('Erro: Node.js 24.12.0 é necessário.'); process.exit(1); }\"",
    "postinstall": "bash scripts/build-node-rdkafka.sh || true",
    "dev": "TURBO_TELEMETRY_DISABLED=1 turbo run dev",
    "dev:public": "TURBO_TELEMETRY_DISABLED=1 turbo run dev --filter=public",
    "dev:manager": "TURBO_TELEMETRY_DISABLED=1 turbo run dev --filter=manager",
    "dev:balancer": "TURBO_TELEMETRY_DISABLED=1 turbo run dev --filter=balancer",
    "dev:service": "TURBO_TELEMETRY_DISABLED=1 turbo run dev --filter=service",
    "dev:schedule": "TURBO_TELEMETRY_DISABLED=1 turbo run dev --filter=schedule_api",
    "dev:web": "TURBO_TELEMETRY_DISABLED=1 turbo run dev --filter=web",
    "dev:worker_baileys": "TURBO_TELEMETRY_DISABLED=1 turbo run dev --filter=worker_baileys",
    "dev:worker_wwebjs": "TURBO_TELEMETRY_DISABLED=1 turbo run dev --filter=worker_wwebjs",
    "dev:worker_whatsmeow": "TURBO_TELEMETRY_DISABLED=1 turbo run dev --filter=worker_whatsmeow",
    "dev:underchat_authenticator": "TURBO_TELEMETRY_DISABLED=1 turbo run dev --filter=underchat_authenticator",
    "dev:mobile": "TURBO_TELEMETRY_DISABLED=1 turbo run dev --filter=mobile",
    "dev:mobile:ios": "TURBO_TELEMETRY_DISABLED=1 turbo run dev --filter=mobile -- --ios",
    "dev:mobile:android": "TURBO_TELEMETRY_DISABLED=1 turbo run dev --filter=mobile -- --android",
    "dev:mobile:web": "TURBO_TELEMETRY_DISABLED=1 turbo run dev --filter=mobile -- --web",
    "dev:mobile:ios:go": "pnpm --filter mobile run ios:go",
    "dev:mobile:android:go": "pnpm --filter mobile run android:go",
    "dev:mobile:ios:dev-client": "pnpm --filter mobile run ios:dev-client",
    "dev:mobile:android:dev-client": "pnpm --filter mobile run android:dev-client",
    "build": "TURBO_TELEMETRY_DISABLED=1 turbo run build",
    "build:public": "GENERATE_OPENAPI=true TURBO_TELEMETRY_DISABLED=1 turbo run build --filter=public",
    "build:manager": "TURBO_TELEMETRY_DISABLED=1 turbo run build --filter=manager",
    "build:balancer": "TURBO_TELEMETRY_DISABLED=1 turbo run build --filter=balancer",
    "build:service": "TURBO_TELEMETRY_DISABLED=1 turbo run build --filter=service",
    "build:schedule": "TURBO_TELEMETRY_DISABLED=1 turbo run build --filter=schedule_api",
    "build:schedule_api": "TURBO_TELEMETRY_DISABLED=1 turbo run build --filter=schedule_api",
    "build:web": "TURBO_TELEMETRY_DISABLED=1 turbo run build --filter=web",
    "build:worker_baileys": "TURBO_TELEMETRY_DISABLED=1 turbo run build --filter=worker_baileys",
    "build:worker_wwebjs": "TURBO_TELEMETRY_DISABLED=1 turbo run build --filter=worker_wwebjs",
    "build:worker_whatsmeow": "TURBO_TELEMETRY_DISABLED=1 turbo run build --filter=worker_whatsmeow",
    "build:underchat_authenticator": "TURBO_TELEMETRY_DISABLED=1 turbo run build --filter=underchat_authenticator",
    "build:underchat_authenticator:dev": "TURBO_TELEMETRY_DISABLED=1 turbo run build:dev --filter=underchat_authenticator",
    "build:underchat_authenticator:prod": "TURBO_TELEMETRY_DISABLED=1 turbo run build:prod --filter=underchat_authenticator",
    "build:mobile": "TURBO_TELEMETRY_DISABLED=1 turbo run build --filter=mobile",
    "package:underchat_authenticator": "TURBO_TELEMETRY_DISABLED=1 turbo run package --filter=underchat_authenticator",
    "package:underchat_authenticator:dev": "TURBO_TELEMETRY_DISABLED=1 turbo run package:dev --filter=underchat_authenticator",
    "package:underchat_authenticator:prod": "TURBO_TELEMETRY_DISABLED=1 turbo run package:prod --filter=underchat_authenticator",
    "lint": "pnpx eslint .",
    "lint:fix": "pnpx eslint . --fix",
    "e2e:connections": "playwright test -c playwright.config.ts packages/tests/e2e/connections.spec.ts",
    "e2e:connections:headed": "playwright test -c playwright.config.ts packages/tests/e2e/connections.spec.ts --headed",
    "e2e:frontend-connections": "playwright test -c playwright.config.ts packages/tests/e2e/channel-frontend-chaos.spec.ts",
    "e2e:frontend-connections:headed": "playwright test -c playwright.config.ts packages/tests/e2e/channel-frontend-chaos.spec.ts --headed",
    "e2e:wwebjs-ad-message": "playwright test -c playwright.config.ts packages/tests/e2e/wwebjs-ad-message-edit.spec.ts",
    "e2e:wwebjs-ad-message:headed": "playwright test -c playwright.config.ts packages/tests/e2e/wwebjs-ad-message-edit.spec.ts --headed",
    "sonar": "sonar-scanner -X",
    "sonar:public": "TURBO_TELEMETRY_DISABLED=1 turbo run sonar --filter=public",
    "sonar:manager": "TURBO_TELEMETRY_DISABLED=1 turbo run sonar --filter=manager",
    "sonar:balancer": "TURBO_TELEMETRY_DISABLED=1 turbo run sonar --filter=balancer",
    "sonar:service": "TURBO_TELEMETRY_DISABLED=1 turbo run sonar --filter=service",
    "sonar:schedule": "TURBO_TELEMETRY_DISABLED=1 turbo run sonar --filter=schedule_api",
    "sonar:web": "TURBO_TELEMETRY_DISABLED=1 turbo run sonar --filter=web",
    "sonar:worker_baileys": "TURBO_TELEMETRY_DISABLED=1 turbo run sonar --filter=worker_baileys",
    "sonar:worker_wwebjs": "TURBO_TELEMETRY_DISABLED=1 turbo run sonar --filter=worker_wwebjs",
    "sonar:worker_whatsmeow": "TURBO_TELEMETRY_DISABLED=1 turbo run sonar --filter=worker_whatsmeow",
    "test": "pnpm run test:locations && jest",
    "test:fast": "JEST_MAX_WORKERS=${JEST_MAX_WORKERS:-50%} pnpm run test",
    "test:serial": "pnpm run test:locations && jest --runInBand",
    "test:watch": "pnpm run test:locations && jest --watch",
    "test:coverage": "pnpm run test:locations && jest --coverage && node scripts/check-per-file-coverage.mjs && node scripts/check-usecases-global-coverage.mjs",
    "test:typecheck": "tsc -p tsconfig.json --noEmit",
    "test:locations": "node scripts/check-test-locations.mjs",
    "kafka:dead-resources:dry-run": "tsx scripts/kafka-clean-dead-resources.ts --dry-run",
    "kafka:dead-resources:delete": "tsx scripts/kafka-clean-dead-resources.ts --execute",
    "atlas:run": "atlas migrate hash --env ${ENV} --var DB_ATLAS=${DB_ATLAS} && atlas migrate apply --env ${ENV} --var DB_ATLAS=${DB_ATLAS} --url \"${DB_DATABASE_URL}\"",
    "atlas:run:docker": "docker compose run --rm -T -e ENV -e DB_ATLAS -e DB_DATABASE_URL under-atlas sh -c 'atlas migrate hash --env ${ENV} --var DB_ATLAS=${DB_ATLAS} && atlas migrate apply --env ${ENV} --var DB_ATLAS=${DB_ATLAS} --url \"${DB_DATABASE_URL}\"'",
    "atlas:run:auto": "if command -v atlas >/dev/null 2>&1; then pnpm run atlas:run; else echo 'Atlas CLI nao encontrado. Usando Docker (under-atlas).' && pnpm run atlas:run:docker; fi",
    "atlas:diff:docker": "docker compose run --rm -T -e ENV -e DB_ATLAS under-atlas sh -c 'atlas migrate diff --env ${ENV} --var DB_ATLAS=${DB_ATLAS}'",
    "atlas:run:dev": "atlas migrate hash --env ${ENV} --var DB_ATLAS=${DB_ATLAS} && atlas migrate apply --exec-order non-linear --env ${ENV} --var DB_ATLAS=${DB_ATLAS} --url \"${DB_DATABASE_URL}\"",
    "atlas:run:dev:docker": "docker compose run --rm -T -e ENV -e DB_ATLAS -e DB_DATABASE_URL under-atlas sh -c 'atlas migrate hash --env ${ENV} --var DB_ATLAS=${DB_ATLAS} && atlas migrate apply --exec-order non-linear --env ${ENV} --var DB_ATLAS=${DB_ATLAS} --url \"${DB_DATABASE_URL}\"'",
    "atlas:run:dev:auto": "if command -v atlas >/dev/null 2>&1; then pnpm run atlas:run:dev; else echo 'Atlas CLI nao encontrado. Usando Docker (under-atlas).' && pnpm run atlas:run:dev:docker; fi",
    "migrate:local": "ENV=prod pnpm run atlas:run:docker",
    "migrate:dev": "ENV=prod pnpm run atlas:run:auto",
    "migrate:prod": "ENV=prod pnpm run atlas:run",
    "seed:local": "pnpm run migrate:local && ENV=dev docker compose run --rm -T -e ENV -e DB_ATLAS -e DB_DATABASE_URL under-atlas sh -c 'atlas migrate hash --env ${ENV} --var DB_ATLAS=${DB_ATLAS} && atlas migrate apply --exec-order non-linear --env ${ENV} --var DB_ATLAS=${DB_ATLAS} --url \"${DB_DATABASE_URL}\"'",
    "seed:dev": "ENV=dev pnpm run atlas:run:dev:auto",
    "seed:zipcode:local": "pnpm run migrate:local && ENV=zipcode docker compose run --rm -T -e ENV -e DB_ATLAS -e DB_DATABASE_URL under-atlas sh -c 'atlas migrate hash --env ${ENV} --var DB_ATLAS=${DB_ATLAS} && atlas migrate apply --exec-order non-linear --env ${ENV} --var DB_ATLAS=${DB_ATLAS} --url \"${DB_DATABASE_URL}\"'",
    "seed:zipcode:dev": "pnpm run migrate:dev && ENV=zipcode atlas migrate hash --env ${ENV} --var DB_ATLAS=${DB_ATLAS} && atlas migrate apply --exec-order non-linear --env ${ENV} --var DB_ATLAS=${DB_ATLAS} --url \"${DB_DATABASE_URL}\"",
    "seed:zipcode:prod": "pnpm run migrate:prod && ENV=zipcode atlas migrate hash --env ${ENV} --var DB_ATLAS=${DB_ATLAS} && atlas migrate apply --exec-order non-linear --env ${ENV} --var DB_ATLAS=${DB_ATLAS} --url \"${DB_DATABASE_URL}\"",
    "create:seed:prod": "ENV=prod docker compose run --rm -T -e ENV -e DB_ATLAS under-atlas sh -c 'atlas migrate new --env ${ENV} --var DB_ATLAS=${DB_ATLAS}'",
    "create:seed:dev": "ENV=dev docker compose run --rm -T -e ENV -e DB_ATLAS under-atlas sh -c 'atlas migrate new --env ${ENV} --var DB_ATLAS=${DB_ATLAS}'",
    "create:seed:zipcode": "ENV=zipcode docker compose run --rm -T -e ENV -e DB_ATLAS under-atlas sh -c 'atlas migrate new --env ${ENV} --var DB_ATLAS=${DB_ATLAS}'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
