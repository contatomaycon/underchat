    "@types/web-push": "^3.6.4",
    "@whiskeysockets/baileys": "https://gitea.devunder.com/underchat/-/packages/npm/@whiskeysockets%2Fbaileys/4.2.2026/files/146",
    "audio-decode": "^2.2.3",
