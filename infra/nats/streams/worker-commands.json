{
  "name": "UC_WORKER_COMMANDS_V1",
  "description": "Shared, worker-filtered command queue for all UnderChat channel containers",
  "subjects": ["uc.worker.command.*"],
  "retention": "workqueue",
  "max_consumers": 2000,
  "max_msgs": 4000000,
  "max_bytes": 8589934592,
  "max_age": 300000000000,
  "max_msgs_per_subject": 10000,
  "max_msg_size": 65536,
  "storage": "file",
  "compression": "s2",
  "num_replicas": 3,
  "no_ack": false,
  "discard": "new",
  "duplicate_window": 300000000000,
  "sealed": false,
  "deny_delete": true,
  "deny_purge": true,
  "allow_rollup_hdrs": false,
  "allow_direct": false,
  "mirror_direct": false,
  "discard_new_per_subject": true,
  "metadata": {
    "underchat.contract": "worker-command-v1",
    "underchat.owner": "worker-command-transport"
  }
}
