{
  "name": "UC_WORKER_FAILURES_V1",
  "description": "Bounded terminal failure evidence for UnderChat worker commands",
  "subjects": ["uc.worker.failure.*"],
  "retention": "limits",
  "max_consumers": 32,
  "max_msgs": -1,
  "max_bytes": 1073741824,
  "max_age": 86400000000000,
  "max_msgs_per_subject": -1,
  "max_msg_size": 65536,
  "storage": "file",
  "compression": "s2",
  "num_replicas": 3,
  "no_ack": false,
  "discard": "new",
  "duplicate_window": 300000000000,
  "sealed": false,
  "deny_delete": true,
  "deny_purge": true,
  "allow_rollup_hdrs": false,
  "allow_direct": false,
  "mirror_direct": false,
  "discard_new_per_subject": false,
  "metadata": {
    "underchat.contract": "worker-failure-v1",
    "underchat.owner": "worker-command-transport"
  }
}
