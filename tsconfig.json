{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "strict": true,
    "jsx": "preserve",
    "declaration": true,
    "outDir": "./dist",
    "composite": true,
    "baseUrl": ".",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "paths": {
      "@core/*": ["packages/*"],
      "@elastic/elasticsearch/lib/api/types": [
        "node_modules/@elastic/elasticsearch/lib/api/types"
      ]
    }
  },
  "include": [
    "packages/**/*",
    "apps/balance_api/src/**/*.ts",
    "apps/manager_api/src/**/*.ts",
    "apps/public_api/src/**/*.ts",
    "apps/service_api/src/**/*.ts",
    "apps/web/src/**/*.ts",
    "apps/web/src/**/*.tsx",
    "apps/web/**/*.ts",
    "apps/web/**/*.tsx",
    "apps/worker_baileys/src/**/*.ts",
    "drizzle.config.ts",
    "jest.config.ts"
  ],
  "exclude": ["node_modules"]
}
