{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "declaration": true,
    "outDir": "./dist",
    "composite": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "paths": {
      "@core/*": ["./packages/*"],
      "@elastic/elasticsearch/lib/api/types": [
        "./node_modules/@elastic/elasticsearch/lib/api/types"
      ]
    }
  },
  "include": ["packages/**/*"],
  "exclude": ["node_modules"]
}
