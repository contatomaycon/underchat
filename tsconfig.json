{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "declaration": true,
    "outDir": "./dist",
    "composite": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "jest"],
    "paths": {
      "@underchat/whatsapp-web-session-browser": [
        "./packages/whatsapp-web-session-browser/src/index.ts"
      ],
      "@underchat/whatsapp-web-session-browser/*": [
        "./packages/whatsapp-web-session-browser/src/*"
      ],
      "@core/*": ["./packages/*"],
      "@elastic/elasticsearch/lib/api/types": [
        "./node_modules/@elastic/elasticsearch/lib/api/types"
      ]
    }
  },
  "include": [
    "packages/**/*",
    "scripts/atlas-migrate.ts",
    "scripts/kafka-clean-dead-resources.ts",
    "scripts/worker-command-operational-barrier.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules"]
}
