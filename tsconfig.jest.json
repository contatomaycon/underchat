{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "incremental": false,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["packages/**/*", "jest.config.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "out",
    "coverage",
    "packages/tests/e2e/**"
  ]
}
