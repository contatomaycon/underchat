# OpenTelemetry
OTEL_ENABLE=true
OTEL_LOG_LEVEL=debug
OTEL_TRACE_SAMPLE_RATE=1.0
OTEL_ENVIRONMENT=LOCAL
# Opcional. Se vazio, o fallback usa npm_package_name (nome do workspace).
# Exemplos: manager, public, balancer, service, schedule, web
OTEL_SERVICE_NAME=
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=LOCAL,service.version=dev

# Configuração do Collector (endpoint único + protocolo)
# grpc ou http/protobuf
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Host local - apps executados via pnpm dev
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Container local - workers criados pelo balancer dentro da rede Docker
OTEL_EXPORTER_OTLP_CONTAINER_ENDPOINT=http://under-otel-lgtm:4318

# Logs de debug de exceções do ciclo de vida da mensagem
# Ative apenas durante investigações de mensagens descartadas, paradas, em retry, DLQ ou erro.
# Quando true, emite apenas pontos de interrupção/falha para OTLP/Loki com debug_index=message_lifecycle.
# Sucesso/progresso de entrada só é emitido quando MESSAGE_LIFECYCLE_INCOMING_SUCCESS_ENABLED=true.
MESSAGE_LIFECYCLE_DEBUG_ENABLED=true
# Ative temporariamente para incluir sucesso/progresso de entrada: receive/map/publish/consume/process.
# Útil quando precisa provar se uma mensagem inbound chegou ao worker/Kafka/service.
MESSAGE_LIFECYCLE_INCOMING_SUCCESS_ENABLED=false
# Mantém sucesso/progresso de saída visível quando MESSAGE_LIFECYCLE_DEBUG_ENABLED=true.
MESSAGE_LIFECYCLE_OUTBOUND_SUCCESS_ENABLED=true
# Limite do texto/conteúdo da mensagem nos logs.
MESSAGE_LIFECYCLE_DEBUG_BODY_LIMIT=500
# Limite do payload bruto/serializado nos logs.
MESSAGE_LIFECYCLE_DEBUG_RAW_LIMIT=4000

# Logs de debug do ciclo de vida da conexão dos canais
# Ative durante investigações de criação, edição, recriação, QR/auth/reconnect/status.
# Quando true, emite fluxo feliz e fluxo de erro para OTLP/Loki com debug_index=connection_lifecycle.
# Eventos received, started, success, published, connected, skipped, retry e error são emitidos.
# QR code e código de pareamento nunca são salvos completos, apenas hash e metadados.
CONNECTION_LIFECYCLE_DEBUG_ENABLED=true
# Limite de valores textuais auxiliares nos logs.
CONNECTION_LIFECYCLE_DEBUG_VALUE_LIMIT=500
# Limite do payload bruto/serializado nos logs.
CONNECTION_LIFECYCLE_DEBUG_RAW_LIMIT=4000
# Tempo em que uma tentativa ativa de QR fica válida para o consumer assíncrono.
CONNECTION_QRCODE_ACTIVE_ATTEMPT_TTL_SECONDS=600
# Deadline do fast path gRPC de QR antes de cair no fallback Kafka assíncrono.
CONNECTION_QR_GRPC_FASTPATH_DEADLINE_MS=5000
# Janela máxima para a lib emitir o primeiro QR/open/close antes de retornar pending com reason=first_qr_timeout.
CONNECTION_QR_FIRST_QR_TIMEOUT_MS=75000
# Cooldown mínimo entre recriações por motivos transitórios durante uma tentativa de QR ativa.
CONNECTION_QR_RECREATE_COOLDOWN_MS=60000
# User agent customizado do WWebJS. Vazio usa o user agent real do Chromium instalado.
WWEBJS_USER_AGENT=
# Timeout do request local de QR no WWebJS; evita stream Redis pendurada quando Chromium/WhatsApp Web travam.
CONNECTION_QRCODE_WWEBJS_LOCAL_REQUEST_TIMEOUT_MS=45000
# Timeouts para teardown/destroy do Chromium no WWebJS.
WWEBJS_CLIENT_DESTROY_TIMEOUT_MS=15000
WWEBJS_PENDING_TEARDOWN_TIMEOUT_MS=20000
# Deadlines finos antes da criação do socket Baileys; se travar, retorna qr_pending com reason específico.
BAILEYS_AUTH_STATE_TIMEOUT_MS=15000
BAILEYS_WA_VERSION_TIMEOUT_MS=15000
# Deadline curto de cada fonte externa usada para resolver a versão do WhatsApp Web antes de usar cache/fallback local.
BAILEYS_WA_VERSION_FETCH_TIMEOUT_MS=2500
# Tempo para reusar versão fallback/cache stale quando as fontes externas de versão falham.
BAILEYS_WA_VERSION_FALLBACK_TTL_MS=900000
BAILEYS_SOCKET_CREATE_TIMEOUT_MS=15000

# Worker Pool
WARM_WORKER_POOL_ENABLED=true
