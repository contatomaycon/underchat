# OpenTelemetry
OTEL_ENABLE=true
OTEL_LOG_LEVEL=info
OTEL_TRACE_SAMPLE_RATE=1.0
OTEL_ENVIRONMENT=LOCAL
# Optional. If empty, fallback uses npm_package_name (workspace name).
# Examples: manager, public, balancer, service, schedule, web
OTEL_SERVICE_NAME=
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=LOCAL,service.version=dev

# Collector config (single endpoint + protocol)
# grpc or http/protobuf
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# grpc - http://otel-collector-opentelemetry-collector.observability.svc.cluster.local:4317
# http/protobuf - https://otel.devunder.com
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector-opentelemetry-collector.observability.svc.cluster.local:4317
