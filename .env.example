E2E_WWEBJS_AD_MESSAGE_ENABLED=false
E2E_BASE_URL=http://localhost:5173
E2E_API_URL=http://localhost:3002/v1
E2E_LOGIN=
E2E_PASSWORD=
E2E_WORKER_ID=
