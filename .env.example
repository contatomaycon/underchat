# Configuração do ambiente
APP_ENVIRONMENT=LOCAL
APP_URL_PUBLIC=localhost:3001
APP_URL_MANAGER=localhost:3002
APP_URL_BALANCER=localhost:3003
APP_URL_SERVICE=localhost:3004
APP_URL_SCHEDULE=10.0.2.36:3005
UNDERCHAT_ENV_SCOPE=private
# Permite HTTP somente para localhost/loopback no node apiRequest do fluxo.
# Aceito apenas em LOCAL/DEV e somente quando normalizado para true.
CHATBOT_API_REQUEST_ALLOW_LOCALHOST_HTTP=false
TZ=America/Sao_Paulo
PGTZ=America/Sao_Paulo

# Configuração do banco de dados
DB_HOST_RW=localhost
DB_PUBLIC_HOST_RW=localhost
DB_PRIVATE_HOST_RW=localhost
DB_PORT_RW=5432
DB_PUBLIC_PORT_RW=5432
DB_PRIVATE_PORT_RW=5432
DB_HOST_RO=localhost
DB_PUBLIC_HOST_RO=localhost
DB_PRIVATE_HOST_RO=localhost
DB_PORT_RO=5432
DB_PUBLIC_PORT_RO=5432
DB_PRIVATE_PORT_RO=5432
DB_USER=admin
DB_PASSWORD=admin
# Credencial LOGIN exclusiva dos runtimes Baileys/WWebJS/WhatsMeow, inclusive
# em legacy_volume. Nao reutilize DB_USER/DB_PASSWORD. O provisionador local
# cria/rotaciona a role e a associa ao grupo NOLOGIN whatsapp_session_runtime.
WORKER_DB_USER=whatsapp_worker_runtime
WORKER_DB_PASSWORD=change-me-worker-runtime
# Confirme true somente em cluster dedicado ao Underchat ou quando pg_hba
# impedir este LOGIN de acessar qualquer database diferente de DB_DATABASE.
WORKER_DB_CLUSTER_ISOLATED=true
DB_DATABASE=underchat
DB_SSLMODE=false
DB_POOL_MIN=10
DB_POOL_MAX=120
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_ACQUIRE_TIMEOUT=30000

# Configuração do Elasticsearch
DB_ELASTIC_HOST=http://localhost:9201
DB_ELASTIC_PUBLIC_HOST=http://localhost:9201
DB_ELASTIC_PRIVATE_HOST=http://localhost:9201
DB_ELASTIC_USER=elastic
DB_ELASTIC_PASSWORD=admin

# Configuração do Atlas
DB_ATLAS=postgres://admin:admin@under-atlas-db:5432/dev?search_path=public&sslmode=disable
DB_PUBLIC_ATLAS=postgres://admin:admin@under-atlas-db:5432/dev?search_path=public&sslmode=disable
DB_PRIVATE_ATLAS=postgres://admin:admin@under-atlas-db:5432/dev?search_path=public&sslmode=disable

# Configuração de cache
DB_CACHE_HOST=localhost
DB_CACHE_PUBLIC_HOST=localhost
DB_CACHE_PRIVATE_HOST=localhost
DB_CACHE_PORT=6379
DB_CACHE_PUBLIC_PORT=6379
DB_CACHE_PRIVATE_PORT=6379
DB_CACHE_PASSWORD=dY5MRW2^!jxHX
AUTOMATION_SEND_DEDUPE_TTL_SECONDS=86400

# Configuração JWT
JWT_SECRET=eyJhbGciOiJIUzI1NiJ9.eyJSb2xlIjoiQWRtaW4iLCJJc3N1ZXIiOiJJc3N1ZXIiLCJVc2VybmFtZSI6IkphdmFJblVzZSIsImV4cCI6MTcwOTU4ODI3OSwiaWF0IjoxNzA5NTg4Mjc5fQ.iQVZxNOrGFkbcJZ5m1V7MFdCYgMr0fE23I2Qcf1lXik
JWT_SECRET_EXPIRES_IN=720h

# Limite de upload
UPLOAD_LIMIT_IN_BYTES=209715200
PUBLIC_API_RATE_LIMIT_PER_MINUTE=120

# Configuração de criptografia
CRYPTO_KEY_START=n2zhrlNPWKZaSz2ZQ23GNYqvg
CRYPTO_KEY_END=uegzCwx2H6XWHwI7OVT1tyK1H

# Configuração do Centrifugo
CENTRIFUGO_HMAC_SECRET_KEY=i9SHlNxpzB1GDU5K0dqzXPpn8eQBs1jKl4yHSWfSpghyvhqP8m
CENTRIFUGO_PUBLIC_WS_URL=ws://localhost:8000
CENTRIFUGO_PRIVATE_WS_URL=ws://localhost:8000
CENTRIFUGO_HTTP_API_URL=http://localhost:8000/api
CENTRIFUGO_PUBLIC_HTTP_API_URL=http://localhost:8000/api
CENTRIFUGO_PRIVATE_HTTP_API_URL=http://localhost:8000/api
CENTRIFUGO_HTTP_API_KEY=lxnxSiQMf3ps1kHNGs7GPvI9P2B2SlXdBwWVSIUe0KZvFY2rGF

# DNS para medição de latência por IP
IP_LATENCY_DNS_IP=8.8.8.8

# Configuração do Kafka
KAFKA_BROKER=localhost:29092,localhost:29093,localhost:29094
KAFKA_PUBLIC_BROKER=localhost:29092,localhost:29093,localhost:29094
KAFKA_PRIVATE_BROKER=localhost:29092,localhost:29093,localhost:29094
SECURITY_PROTOCOL=PLAINTEXT
KAFKA_PUBLIC_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_PRIVATE_SECURITY_PROTOCOL=PLAINTEXT
# Provisionamento/finalização reutilizam estas credenciais por default; nenhuma
# variável administrativa adicional é necessária.
KAFKA_PUBLIC_USERNAME=
KAFKA_PRIVATE_USERNAME=
KAFKA_PUBLIC_PASSWORD=
KAFKA_PRIVATE_PASSWORD=
KAFKA_PUBLIC_SASL_MECHANISM=
KAFKA_PRIVATE_SASL_MECHANISM=
KAFKA_CONSUMER_QUEUED_MIN_MESSAGES=1
KAFKA_CONSUMER_FETCH_QUEUE_BACKOFF_MS=10
KAFKA_METADATA_REFRESH_INTERVAL_MS=1000
KAFKA_METADATA_MAX_AGE_MS=3000
KAFKA_METADATA_REFRESH_FAST_INTERVAL_MS=100
KAFKA_METADATA_REFRESH_FAST_COUNT=20
KAFKA_TOPIC_METADATA_PROPAGATION_MAX_MS=5000
KAFKA_CONSUMER_METADATA_REFRESH_TIMEOUT_MS=5000
KAFKA_CONSUMER_ASSIGNMENT_READY_TIMEOUT_MS=10000
KAFKA_CONSUMER_SEND_IDLE_RESTART_MS=0
# Opcional; sem ENV, todas as filas usam auto-recuperação sem commit.
KAFKA_CONSUMER_STALL_RESTART_SCOPE=all
# Opcional; backlog sem handler pendente usa 90000ms por padrão.
KAFKA_CONSUMER_IDLE_LAG_STALL_MS=90000
# Opcional; três falhas consecutivas de leitura do lag acionam recuperação.
KAFKA_CONSUMER_MAX_LAG_MEASUREMENT_FAILURES_BEFORE_RECOVERY=3
WORKER_KAFKA_SEND_CONSUMER_IDLE_RECREATE_INTERVAL=0
KAFDROP_HOST_PORT=9004

# Transporte de comandos dos containers de canal: sempre JetStream. Não há
# fallback para Kafka; indisponibilidade do PubAck deve rejeitar o comando.
WORKER_COMMAND_TRANSPORT=jetstream
# Os tres endpoints usam o IP desta maquina e portas diferentes. Containers de
# canal recebem NATS_PUBLIC_URL; WorkerService a normaliza como NATS_URL.
# NATS_PRIVATE_URL nunca cruza o boundary desses workers.
NATS_URL=nats://10.0.2.12:4222,nats://10.0.2.12:4223,nats://10.0.2.12:4224
NATS_PUBLIC_URL=nats://10.0.2.12:4222,nats://10.0.2.12:4223,nats://10.0.2.12:4224
NATS_PRIVATE_URL=nats://10.0.2.12:4222,nats://10.0.2.12:4223,nats://10.0.2.12:4224
NATS_USER=underchat_runtime
NATS_PASSWORD=underchat_local_runtime_only
NATS_TLS=false
NATS_CONNECTION_NAME=underchat-local
# Principals exclusivos do bootstrap, monitoramento e rotas do Compose local.
# Gere valores próprios para qualquer ambiente que não seja descartável/local.
NATS_ADMIN_USER=underchat_admin
NATS_ADMIN_PASSWORD=underchat_local_admin_only
NATS_SYSTEM_USER=underchat_system
NATS_SYSTEM_PASSWORD=underchat_local_system_only
NATS_ROUTE_USER=underchat_route
NATS_ROUTE_PASSWORD=underchat_local_route_only
NATS_HOST_PORT_1=4222
NATS_HOST_PORT_2=4223
NATS_HOST_PORT_3=4224
NATS_MONITOR_HOST_PORT_1=8222
NATS_MONITOR_HOST_PORT_2=8223
NATS_MONITOR_HOST_PORT_3=8224

# Configuração de build do Harbor
HARBOR_REGISTRY=harbor.devunder.com
HARBOR_NAMESPACE=underchat/balance
HARBOR_USERNAME='robot$under'
HARBOR_PASSWORD=password

# Configuração de build
BUILD_ENGINE=docker
BUILD_KANIKO_EXECUTOR_PATH=/kaniko/executor
# Overrides opcionais; o executor já usa estes defaults sem configuração:
# BUILD_GIT_CLONE_DIR=/var/tmp/underchat-build-source
# BUILD_WORKSPACE_MIN_FREE_BYTES=2147483648
# BUILD_WORKSPACE_MIN_FREE_INODES=20000
# BUILD_WORKSPACE_ORPHAN_MAX_AGE_MS=86400000
BUILD_COMMAND_INACTIVITY_TIMEOUT_MS=600000
BUILD_COMMAND_MAX_DURATION_MS=7200000
BUILD_HEARTBEAT_INTERVAL_MS=15000
BUILD_STALE_RUNNING_ITEM_TIMEOUT_MS=1200000
BUILD_STALE_CHECK_INTERVAL_MS=60000
SERVICE_API_ENABLE_BUILD_CONSUMERS=true
SERVICE_API_ENABLE_NON_BUILD_CONSUMERS=true
# Opcional; ausência mantém a autorrecuperação de workers ativos habilitada.
# Use false somente durante um gate operacional controlado de pool aquecido.
SCHEDULE_WORKER_MONITOR_ENABLED=true

# Orçamentos ordenados do lifecycle. A migração volume -> PostgreSQL exige
# confirmação online da sessão preservada e nunca usa o limite curto da
# recriação comum. Os defaults já são seguros; sobrescreva somente em hosts
# cujo perfil WWebJS comprovadamente precise de uma janela maior.
WORKER_RECREATE_CONNECTION_CONFIRMATION_WAIT_MS=60000
WORKER_SESSION_STORAGE_MIGRATION_CONNECTION_CONFIRMATION_WAIT_MS=240000
WORKER_SESSION_STORAGE_MIGRATION_ATTEMPT_MS=540000
WORKER_PROVIDER_HANDOFF_CONNECTION_CONFIRMATION_WAIT_MS=300000

# Imagens dos workers provisionadas pelo Balance
WORKER_IMAGE_PROVISION_TIMEOUT_MS=300000
WORKER_IMAGE_DEFAULT_CACHE_TTL_MS=3000
WORKER_IMAGE_RECONCILE_INTERVAL_MS=30000
# Publicar uma imagem nunca recria canais ativos. O reconciliador apenas
# provisiona e observa drift; a atualização do runtime é sempre manual.
# Overrides são aceitos somente fora de produção e com tag test-*.
# WORKER_IMAGE_BAILEYS_REFERENCE=under-worker-baileys:test-candidate
# WORKER_IMAGE_WWEBJS_REFERENCE=under-worker-wwebjs:test-candidate
# WORKER_IMAGE_WHATSMEOW_REFERENCE=under-worker-whatsmeow:test-candidate

# Rollout reconciliado do próprio Balance nos servidores existentes
# Três aprovações são obrigatórias: habilitar, fixar o digest e declarar a
# allowlist. Use "*" sozinho somente depois de validar o canário.
BALANCE_IMAGE_ROLLOUT_ENABLED=false
BALANCE_IMAGE_ROLLOUT_APPROVED_DIGEST=
BALANCE_IMAGE_ROLLOUT_SERVER_IDS=
BALANCE_IMAGE_ROLLOUT_READINESS_TIMEOUT_MS=420000
BALANCE_IMAGE_ROLLOUT_STABILITY_WINDOW_MS=120000
BALANCE_IMAGE_ROLLOUT_RETRY_COOLDOWN_MS=900000
BALANCE_IMAGE_ROLLOUT_COMMAND_TIMEOUT_MS=900000

# Configuração do Git
GIT_TOKEN=
GIT_REPO=underchat/underchat
GIT_BRANCH=dev

# Configuração S3
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=adminadmin
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9002

# Configuração S3 de backup
S3_ACCESS_KEY_ID_BACKUP=admin
S3_SECRET_ACCESS_KEY_BACKUP=adminadmin
S3_REGION_BACKUP=us-east-1
S3_ENDPOINT_BACKUP=http://localhost:9002
S3_NFSE_CERTIFICATE_BUCKET=nfs

# Configuração SMTP
SMTP_SERVER=mail.smtp2go.com
SMTP_PORT=2525
SMTP_USERNAME="no-reply.underchat.com.br"
SMTP_PASSWORD=
SMTP_FROM="no-reply.underchat.com.br"
SMTP_SECURE=false
SMTP_TLS=true

# Configuração Asaas
ASAAS_HOST=
ASAAS_WALLET_ID=
ASAAS_TOKEN=
ASAAS_WEBHOOK=auYCqzErXOoS7wyfiQIP16nGDkSgljscU7ZF7P6bYfu4bjHoC4TVI3O5vyTZJBwGn63DctX0G1R4vRHN1BHB48MG5Mb0UfI9th7R

# Notificações
VAPID_PUBLIC_KEY=BE-orwUj3JO03BUmENEJFSOBg6aLWi8r-HlrsxC5bWCX3zmVdDhQqmtFzwOAS8i1DyHx1RIHUY43Js09KJAHSEo
VAPID_PRIVATE_KEY=VaVvVXq5jQQMub_DRXVRNVH2b_SkBApKX2Hdk4kXrUU
VAPID_CONTACT_EMAIL=noreply@underchat.com

# Worker Pool
WARM_WORKER_POOL_ENABLED=true

# Configurações opcionais; quando ausentes, os workers usam os defaults abaixo.
# Prazo das chamadas auxiliares aos SDKs WhatsApp (perfil, presença e leitura).
WHATSAPP_PROVIDER_AUXILIARY_TIMEOUT_MS=15000
MEDIA_DOWNLOAD_REQUEST_TIMEOUT_MS=45000
MEDIA_DOWNLOAD_MAX_BYTES=134217728

# Resiliência do envio/Kafka. Todos os valores abaixo são opcionais.
CRITICAL_REDIS_OPERATION_TIMEOUT_MS=3000
KAFKA_CONSUMER_RESTART_BACKOFF_STABLE_MS=30000
META_WHATSAPP_GRAPH_REQUEST_TIMEOUT_MS=45000
BAILEYS_SEND_MESSAGE_TIMEOUT_MS=45000
WWEBJS_SEND_MESSAGE_TIMEOUT_MS=45000
WORKER_SEND_TIMEOUT=45s
# Opcional: ausente, vazio, inválido ou não positivo usa o default seguro 4.
# Valores acima de 64 são limitados a 64; não é necessário definir no deploy.
# WORKER_PROVIDER_SEND_MAX_IN_FLIGHT=4

# Estes limites não habilitam nem desabilitam a digitação. A opção e a
# velocidade continuam configuráveis por cliente.
TYPING_SIMULATION_MAX_DELAY_MS=15000
WORKER_SEND_PROVIDER_RESERVE_MS=20000
WORKER_TYPING_MAX_ORPHANS=8

# Fence distribuído dos efeitos do provider.
WHATSAPP_RUNTIME_EFFECT_LEASE_TTL_MS=45000
WHATSAPP_RUNTIME_EFFECT_LEASE_HEARTBEAT_MS=5000
# Temporariamente ativo durante o rollout do store unificado. Os eventos usam
# o prefixo [whatsapp-session-debug] e nunca incluem chaves, QR, cookies ou URLs.
WHATSAPP_SESSION_DEBUG_ENABLED=true

# Prazos de monitoramento e encerramento; ausência usa estes defaults.
WORKER_SELF_MONITOR_READINESS_TIMEOUT_MS=15000
WORKER_LIVENESS_RECREATE_COOLDOWN_SECONDS=600
WORKER_NODE_SHUTDOWN_TIMEOUT_MS=25000
BALANCE_API_SHUTDOWN_TIMEOUT_MS=8000
# Vazio usa primeiro o helper empacotado na imagem e depois o helper do repo.
WORKER_LIVENESS_CONDITIONAL_REMOVE_SCRIPT=

# Isolamento de recursos dos workers (warm e ativos).
# Todas as variáveis desta seção são opcionais; ausência usa estes defaults.
WORKER_CONTAINER_RESOURCE_LIMITS_ENABLED=true
WORKER_CONTAINER_BAILEYS_MEMORY_MB=1536
WORKER_CONTAINER_BAILEYS_CPU_MILLIS=1500
WORKER_CONTAINER_WWEBJS_MEMORY_MB=3072
WORKER_CONTAINER_WWEBJS_CPU_MILLIS=2000
WORKER_CONTAINER_WHATSMEOW_MEMORY_MB=1024
WORKER_CONTAINER_WHATSMEOW_CPU_MILLIS=1000
WORKER_CONTAINER_PIDS_LIMIT=512

# Os limites WARM abaixo valem apenas para standbys legados com volume, que são
# substituídos na ativação. Standbys PostgreSQL são promovidos no mesmo
# container e por isso já nascem com os limites ativos definidos acima.
WORKER_CONTAINER_WARM_BAILEYS_MEMORY_MB=256
WORKER_CONTAINER_WARM_BAILEYS_CPU_MILLIS=250
WORKER_CONTAINER_WARM_BAILEYS_PIDS_LIMIT=128
WORKER_CONTAINER_WARM_WWEBJS_MEMORY_MB=384
WORKER_CONTAINER_WARM_WWEBJS_CPU_MILLIS=250
WORKER_CONTAINER_WARM_WWEBJS_PIDS_LIMIT=256
WORKER_CONTAINER_WARM_WHATSMEOW_MEMORY_MB=192
WORKER_CONTAINER_WARM_WHATSMEOW_CPU_MILLIS=250
WORKER_CONTAINER_WARM_WHATSMEOW_PIDS_LIMIT=128

# Admissão física local opt-in. Reservation representa o peso steady-state;
# hard limit é uma segunda cerca. Ausência mantém a admissão desativada.
WORKER_CONTAINER_ADMISSION_ENABLED=false
WORKER_CONTAINER_HOST_RESERVED_MEMORY_MB=512
WORKER_CONTAINER_HOST_RESERVED_MEMORY_PERCENT=15
WORKER_CONTAINER_ADMISSION_RESERVATION_OVERCOMMIT_PERCENT=150
WORKER_CONTAINER_ADMISSION_HARD_LIMIT_OVERCOMMIT_PERCENT=300
WORKER_CONTAINER_ADMISSION_INVENTORY_LIMIT=1000
WORKER_CONTAINER_ADMISSION_INSPECT_CONCURRENCY=8
WORKER_CONTAINER_ADMISSION_INSPECT_TIMEOUT_MS=5000
