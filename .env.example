DB_POOL_ACQUIRE_TIMEOUT=30000

# Connection E2E Tests (Playwright)
# Opt-in only. Use a disposable disconnected channel because the suite changes
# the channel type and recreates containers while validating QR generation.
E2E_CONNECTIONS_ENABLED=false
E2E_BASE_URL=http://localhost:5173
E2E_API_URL=http://localhost:3002/v1
E2E_LOGIN=
E2E_PASSWORD=
E2E_WORKER_ID=
E2E_WORKER_NAME=
E2E_TYPE_PATCH_MAX_MS=3000
E2E_CONNECT_ACK_MAX_MS=3000
E2E_TYPE_READY_MAX_MS=60000
E2E_QR_MAX_MS=30000

# Optional DB override for E2E. If empty, the test uses DB_HOST_RO/DB_PORT_RO
# and the shared DB_USER/DB_PASSWORD/DB_DATABASE/DB_SSLMODE values above.
E2E_DB_HOST=
E2E_DB_PORT=
E2E_DB_USER=
E2E_DB_PASSWORD=
E2E_DB_DATABASE=
E2E_DB_SSLMODE=

