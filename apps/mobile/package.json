{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "dev": "ANDROID_HOME=${ANDROID_HOME:-$HOME/Android/Sdk} PATH=${ANDROID_HOME}/platform-tools:$PATH expo start --localhost",
    "start": "ANDROID_HOME=${ANDROID_HOME:-$HOME/Android/Sdk} PATH=${ANDROID_HOME}/platform-tools:$PATH expo start --localhost",
    "android": "ANDROID_HOME=${ANDROID_HOME:-$HOME/Android/Sdk} PATH=${ANDROID_HOME}/platform-tools:$PATH expo start --android --localhost",
    "ios": "ANDROID_HOME=${ANDROID_HOME:-$HOME/Android/Sdk} PATH=${ANDROID_HOME}/platform-tools:$PATH expo start",
    "web": "expo start --web --localhost",
    "build": "expo export --platform web"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "7.15.2",
    "@react-navigation/native": "7.1.31",
    "@react-navigation/native-stack": "7.14.2",
    "expo": "~55.0.4",
    "expo-audio": "^55.0.8",
    "expo-build-properties": "^55.0.9",
    "expo-image-picker": "~55.0.10",
    "expo-media-library": "~55.0.9",
    "expo-status-bar": "~55.0.4",
    "expo-video": "~55.0.10",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.14",
    "typescript": "~5.9.3"
  },
  "private": true
}
