{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "dev": "ANDROID_HOME=${ANDROID_HOME:-$HOME/Android/Sdk} PATH=${ANDROID_HOME}/platform-tools:$PATH EXPO_UNSTABLE_BONJOUR=0 expo start --localhost",
    "start": "ANDROID_HOME=${ANDROID_HOME:-$HOME/Android/Sdk} PATH=${ANDROID_HOME}/platform-tools:$PATH EXPO_UNSTABLE_BONJOUR=0 expo start --localhost",
    "start:go": "ANDROID_HOME=${ANDROID_HOME:-$HOME/Android/Sdk} PATH=${ANDROID_HOME}/platform-tools:$PATH EXPO_UNSTABLE_BONJOUR=0 expo start --localhost",
    "start:dev-client": "ANDROID_HOME=${ANDROID_HOME:-$HOME/Android/Sdk} PATH=${ANDROID_HOME}/platform-tools:$PATH EXPO_UNSTABLE_BONJOUR=0 expo start --dev-client --localhost",
    "android": "ANDROID_HOME=${ANDROID_HOME:-$HOME/Android/Sdk} PATH=${ANDROID_HOME}/platform-tools:$PATH EXPO_UNSTABLE_BONJOUR=0 expo start --dev-client --android --localhost",
    "ios": "ANDROID_HOME=${ANDROID_HOME:-$HOME/Android/Sdk} PATH=${ANDROID_HOME}/platform-tools:$PATH EXPO_UNSTABLE_BONJOUR=0 expo start --dev-client --ios --localhost",
    "android:go": "ANDROID_HOME=${ANDROID_HOME:-$HOME/Android/Sdk} PATH=${ANDROID_HOME}/platform-tools:$PATH EXPO_UNSTABLE_BONJOUR=0 expo start --android --localhost",
    "ios:go": "ANDROID_HOME=${ANDROID_HOME:-$HOME/Android/Sdk} PATH=${ANDROID_HOME}/platform-tools:$PATH EXPO_UNSTABLE_BONJOUR=0 expo start --ios --localhost",
    "android:dev-client": "ANDROID_HOME=${ANDROID_HOME:-$HOME/Android/Sdk} PATH=${ANDROID_HOME}/platform-tools:$PATH EXPO_UNSTABLE_BONJOUR=0 expo start --dev-client --android --localhost",
    "ios:dev-client": "ANDROID_HOME=${ANDROID_HOME:-$HOME/Android/Sdk} PATH=${ANDROID_HOME}/platform-tools:$PATH EXPO_UNSTABLE_BONJOUR=0 expo start --dev-client --ios --localhost",
    "run:android": "ANDROID_HOME=${ANDROID_HOME:-$HOME/Android/Sdk} PATH=${ANDROID_HOME}/platform-tools:$PATH expo run:android",
    "run:ios": "ANDROID_HOME=${ANDROID_HOME:-$HOME/Android/Sdk} PATH=${ANDROID_HOME}/platform-tools:$PATH expo run:ios",
    "eas:build:dev:android": "eas build --profile development --platform android",
    "eas:build:apk:android": "eas build --profile preview-apk --platform android",
    "eas:build:aab:android": "eas build --profile production-aab --platform android",
    "build:android:apk": "pnpm run eas:build:apk:android",
    "build:android:aab": "pnpm run eas:build:aab:android",
    "eas:build:dev:ios": "eas build --profile development --platform ios",
    "eas:build:prod:ios": "eas build --profile production-ios --platform ios",
    "eas:submit:ios": "eas submit --profile production-ios --platform ios",
    "build:ios:testflight": "pnpm run eas:build:prod:ios",
    "submit:ios:testflight": "pnpm run eas:submit:ios",
    "web": "EXPO_UNSTABLE_BONJOUR=0 expo start --web --localhost",
    "build": "expo export --platform web"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-navigation/bottom-tabs": "7.15.2",
    "@react-navigation/native": "7.1.31",
    "@react-navigation/native-stack": "7.14.2",
    "emoji-datasource": "^16.0.0",
    "expo": "~55.0.5",
    "expo-asset": "~55.0.8",
    "expo-audio": "^55.0.8",
    "expo-blur": "^55.0.8",
    "expo-build-properties": "^55.0.9",
    "expo-clipboard": "^55.0.8",
    "expo-constants": "~55.0.7",
    "expo-dev-client": "~55.0.11",
    "expo-document-picker": "~55.0.8",
    "expo-image-picker": "~55.0.11",
    "expo-location": "~55.1.2",
    "expo-media-library": "~55.0.9",
    "expo-notifications": "~55.0.11",
    "expo-sharing": "~55.0.11",
    "expo-status-bar": "~55.0.4",
    "expo-video": "~55.0.10",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-maps": "1.26.20",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-video-trim": "^6.0.13",
    "react-native-worklets": "0.7.2",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.14",
    "eas-cli": "^18.0.6",
    "typescript": "~5.9.3"
  },
  "private": true
}
