{
  "cli": {
    "version": ">= 16.13.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": {
        "buildType": "apk"
      }
    },
    "preview-apk": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "production-aab": {
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production-ios": {
      "distribution": "store",
      "environment": "production"
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "ios": {
        "simulator": true
      }
    }
  },
  "submit": {
    "production-ios": {
      "ios": {}
    }
  }
}
