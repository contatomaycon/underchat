{
  "_global": {
    "selector_definitions": [
      {
        "key": "input_box",
        "description": "Campo de entrada de texto do usuário (textarea ou elemento contenteditable)",
        "enabled": true,
        "required": true
      },
      {
        "key": "send_btn",
        "description": "Botão para enviar mensagem (normalmente type=submit ou com ícone de envio)",
        "enabled": true,
        "required": true
      },
      {
        "key": "result_container",
        "description": "Container da resposta da IA (apenas o texto de saída da IA, sem mensagens do usuário)",
        "enabled": true,
        "required": true
      },
      {
        "key": "new_chat_btn",
        "description": "Botão para iniciar nova conversa (ao clicar, começa um novo chat)",
        "enabled": true,
        "required": false
      },
      {
        "key": "message_wrapper",
        "description": "Container completo da mensagem (envolve cada mensagem para composição de múltiplos nós)",
        "enabled": false,
        "required": false
      },
      {
        "key": "generating_indicator",
        "description": "Indicador de geração em andamento (ex.: botão parar, animação de carregamento)",
        "enabled": false,
        "required": false
      },
      {
        "key": "upload_btn",
        "description": "Botão de upload que abre o seletor de arquivos do sistema",
        "enabled": false,
        "required": false
      },
      {
        "key": "file_input",
        "description": "Campo nativo de arquivo (input[type=file]) para injeção direta de arquivos",
        "enabled": false,
        "required": false
      },
      {
        "key": "drop_zone",
        "description": "Área com suporte a upload por arrastar e soltar",
        "enabled": false,
        "required": false
      }
    ]
  },
  "aistudio.google.com": {
