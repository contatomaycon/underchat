# API
APP_HOST=0.0.0.0
APP_PORT=8199
APP_DEBUG=false

# Browser debugging
BROWSER_PORT=9222

# Runtime defaults for containerized production
AUTO_UPDATE_ENABLED=false

# noVNC / VNC
NOVNC_PORT=6080
VNC_PORT=5900
# Optional password (leave empty for no password)
VNC_PASSWORD=

# Audio transcription backend
# Values: auto | api | local
AUDIO_TRANSCRIPTION_MODE=auto
AUDIO_TRANSCRIPTION_BASE_URL=
AUDIO_TRANSCRIPTION_API_KEY=
AUDIO_TRANSCRIPTION_MODEL=whisper-1
AUDIO_TRANSCRIPTION_LOCAL_MODEL=base
AUDIO_TRANSCRIPTION_DEVICE=cpu
AUDIO_TRANSCRIPTION_COMPUTE_TYPE=int8

# Audio speech backend
# Values: auto | api | local
AUDIO_SPEECH_MODE=auto
AUDIO_SPEECH_BASE_URL=
AUDIO_SPEECH_API_KEY=
AUDIO_SPEECH_MODEL=tts-1
AUDIO_SPEECH_LOCAL_VOICE=pt-br
AUDIO_SPEECH_DEFAULT_FORMAT=mp3

# Shared timeout (seconds) for upstream audio API calls
AUDIO_API_TIMEOUT=180
