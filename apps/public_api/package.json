{
  "name": "public",
  "version": "1.123.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.12.0"
  },
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.tsx.json src/index.ts",
    "build": "tsc && tsc-alias -p tsconfig.json -f -fe .js",
    "lint": "pnpx eslint . --fix",
    "sonar": "sonar-scanner -X",
    "generate:openapi": "export GENERATE_OPENAPI=true && pnpm run build && node dist/apps/public_api/src/docs.js"
  }
}
