{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "lib": ["ES2022"],
    "moduleResolution": "bundler",
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "../../",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "typeRoots": ["./node_modules/@types"],
    "paths": {
      "@core/common/functions/kafkaTopicRecoveryPolicy": [
        "../../packages/common/functions/workerKafkaTopicRecoveryPolicy.ts"
      ],
      "@core/config/environments": [
        "../../packages/config/environments/WorkerEnvironment.ts"
      ],
      "@/*": ["./src/*"],
      "@core/*": ["../../packages/*"],
      "@elastic/elasticsearch/lib/api/types": [
        "../../node_modules/@elastic/elasticsearch/lib/api/types"
      ]
    }
  },
  "include": [
    "src/**/*",
    "../../packages/common/types/fastify.worker.d.ts",
    "../../packages/common/types/node-forge.d.ts",
    "../../packages/common/types/wwebjs-canonical-session-bridge.d.ts",
    "../../packages/plugins/proto/workerConnectionGrpcServer.ts"
  ],
  "exclude": ["node_modules"]
}
