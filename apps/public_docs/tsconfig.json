{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "vitepress/client"]
  },
  "include": [
    "env.d.ts",
    "docs/.vitepress/**/*.ts",
    "docs/.vitepress/**/*.vue",
    "docs/**/*.md"
  ],
  "exclude": ["dist", "node_modules", "docs/.vitepress/cache"]
}
