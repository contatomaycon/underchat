{
  "name": "underchat_chrome_extension",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "description": "Underchat Chrome extension for connecting authenticated WhatsApp Web sessions.",
  "scripts": {
    "build": "pnpm run build:prod",
    "build:dev": "tsc --noEmit && vite build --mode development",
    "build:prod": "tsc --noEmit && vite build --mode production",
    "dev": "vite build --watch --mode development",
    "package:dev": "pnpm run build:dev && node scripts/package-extension.mjs dev",
    "package:prod": "pnpm run build:prod && node scripts/package-extension.mjs prod",
    "release:dev": "pnpm run package:dev",
    "release:prod": "pnpm run package:prod"
  },
  "dependencies": {
    "@underchat/whatsapp-web-session-browser": "workspace:*",
    "@wwebjs/whatsapp-web.js": "https://gitea.devunder.com/api/packages/underchat/npm/%40wwebjs%2Fwhatsapp-web.js/-/1.34.150/whatsapp-web.js-1.34.150.tgz"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vite": "8.1.0"
  }
}
